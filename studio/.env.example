# Copy this file to `.env`. Use the same project id as app/.env.
# Only SANITY_STUDIO_* variables reach the studio bundle.

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_TITLE=Studio

# The app's origin, no trailing slash, e.g. http://localhost:3000. The Spotify
# sync and Refresh website panels call its /api/podcast-sync and
# /api/revalidate routes. Not a secret.
SANITY_STUDIO_SITE_URL=
